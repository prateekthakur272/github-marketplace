# All values are public: they are baked into the static site.
NEXT_PUBLIC_GITHUB_OWNER=prateekthakur272
# Optional read-only token (public repo access only). Without it the REST API
# is used (60 requests/hour per visitor).
NEXT_PUBLIC_GITHUB_TOKEN=
# Optional: when both are set, data is loaded from Supabase instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shown in the side pane footer (the deploy workflow sets it from the tag).
NEXT_PUBLIC_APP_VERSION=dev
# Set to "/<repo-name>" when hosting under a GitHub Pages project URL.
NEXT_PUBLIC_BASE_PATH=
